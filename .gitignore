# Generated crawl data: large, reproducible, and not committed.

# Blog post HTML generated by crawler.py.
posts/

# Tableau Public workbooks and screenshots generated by download scripts.
dashboards/

# Normalized dataset rebuilt from posts/ and dashboards/.
dataset/

# Author workbooks are analysis-only and must not enter iteration inputs.
iterations/*/inputs/*.twb
iterations/*/inputs/*.twbx

# Logs
*.log
run_full.log

# ===== Python =====
.venv/
__pycache__/
*.pyc

# Operating system files
.DS_Store
Thumbs.db
.worktrees/

# Intermediate captures stay on the validation server; current exports and run hashes are committed.
iterations/*/evidence/cloud-runs/**/*.png
iterations/*/evidence/cloud-runs/**/*.csv

# Downloaded full articles are analysis-only; source URLs and hashes are recorded.
iterations/*/evidence/article-analysis.html
