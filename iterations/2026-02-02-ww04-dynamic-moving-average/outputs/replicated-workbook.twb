  <worksheets>
    <worksheet name="Dynamic Moving Average"><layout-options><caption><formatted-text><run>Sales and trailing moving average by the selected date grain</run></formatted-text></caption></layout-options><table><view><datasources><datasource caption="Orders (Sample - Superstore)" name="federated.1yenh2r0raklpz16s6fvu0d3hrwm"/></datasources><datasource-dependencies datasource="federated.1yenh2r0raklpz16s6fvu0d3hrwm"><column caption="Moving Average" datatype="real" name="[Calculation1]" role="measure" type="quantitative">
        <calculation class="tableau" formula="WINDOW_AVG(SUM([Sales]), -1*([Parameters].[Parameter 2]-1), 0)">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="Display Date" datatype="date" name="[Calculation_1153484486913081344]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATE(DATETRUNC([Parameters].[Parameter 1],[Order Date]))"/>
      </column>
      <column caption="Date to Display" datatype="boolean" name="[Calculation_1153484486915448835]" role="measure" type="nominal">
        <calculation class="tableau" formula="MIN([Order Date])&gt;DATEADD([Parameters].[Parameter 1],-1*([Parameters].[Parameter 3]),[Calculation_1153484486914629634])">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
