      <column caption="Moving Average" datatype="real" name="[Calculation1]" role="measure" type="quantitative">
        <calculation class="tableau" formula="WINDOW_AVG(SUM([Sales]), -1*([Parameters].[Parameter 2]-1), 0)">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="Display Date" datatype="date" name="[Calculation_1153484486913081344]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATE(DATETRUNC([Parameters].[Parameter 1],[Order Date]))"/>
      </column>
      <column caption="Latest Date" datatype="date" name="[Calculation_1153484486914629634]" role="measure" type="ordinal">
        <calculation class="tableau" formula="WINDOW_MAX(MAX([Calculation_1153484486913081344]))">
          <table-calc ordering-type="Rows"/>
