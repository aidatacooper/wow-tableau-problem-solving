  <worksheets><worksheet name="Viz"><layout-options><title><formatted-text><run>WHEN DID 2018 CATEGORY SALES DROP AND RISE THE MOST?</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Orders (Sample - Superstore)" name="federated.0ahyg8e1xelf3914bag3r0yukuro"/></datasources><datasource-dependencies datasource="federated.0ahyg8e1xelf3914bag3r0yukuro"><column datatype="string" name="[Category]" role="dimension" type="nominal"/><column caption="Colour:Diff" datatype="string" name="[WW32_Colour_Diff]" role="measure" type="nominal"><calculation class="tableau" formula="IF [WW32_Is_Max_Value] THEN 'blue' ELSEIF [WW32_Is_Min_Value] THEN 'red' ELSE 'grey' END"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL:First Last if not max or min" datatype="real" name="[WW32_LABEL_First_Last_if_not_max_or_min]" role="measure" type="quantitative"><calculation class="tableau" formula="IF FIRST() = 0 THEN SUM([WW32_Sales_In_Month]) ELSEIF LAST() = 0 THEN IF NOT(LOOKUP([WW32_Is_Min_Value], -1)) AND NOT(LOOKUP([WW32_Is_Max_Value], -1)) THEN SUM([WW32_Sales_In_Month]) END END"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL: Max Diff + Shift" datatype="real" name="[WW32_LABEL_Max_Diff_Shift]" role="measure" type="quantitative"><calculation class="tableau" formula="LOOKUP([WW32_LABEL_Max_Diff], -1)"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL: Min Diff + Shift" datatype="real" name="[WW32_LABEL_Min_Diff_Shift]" role="measure" type="quantitative"><calculation class="tableau" formula="LOOKUP([WW32_LABEL_Min_Diff], -1)"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL:Month Position To Display" datatype="date" name="[WW32_LABEL_Month_Position_To_Display]" role="dimension" type="quantitative"><calculation class="tableau" formula="IF MONTH([WW32_Month_Position_To_Plot]) = 12 THEN [WW32_Month_Position_To_Plot] ELSE IF DAY([WW32_Month_Position_To_Plot]) = 1 THEN [WW32_Month_Position_To_Plot] ELSE DATE(DATEADD('day', 1, [WW32_Month_Position_To_Plot])) END END"/></column><column caption="LABEL:Sales Diff" datatype="real" name="[WW32_LABEL_Sales_Diff]" role="measure" type="quantitative"><calculation class="tableau" formula="IF ([WW32_Sales_Next_Value] - SUM([WW32_Sales_In_Month])) = 0 THEN LOOKUP([WW32_Sales_Next_Value], -1) - LOOKUP(SUM([WW32_Sales_In_Month]), -1) ELSE [WW32_Sales_Next_Value] - SUM([WW32_Sales_In_Month]) END"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL:Sales in Month Max" datatype="real" name="[WW32_LABEL_Sales_in_Month_Max]" role="measure" type="quantitative"><calculation class="tableau" formula="IF NOT(ZN([WW32_LABEL_Max_Diff_Shift]) = 0) THEN SUM([WW32_Sales_In_Month]) END"><table-calc ordering-type="Rows"/></calculation></column><column caption="LABEL:Sales in Month Min" datatype="real" name="[WW32_LABEL_Sales_in_Month_Min]" role="measure" type="quantitative"><calculation class="tableau" formula="IF NOT(ZN([WW32_LABEL_Min_Diff_Shift]) = 0) THEN SUM([WW32_Sales_In_Month]) END"><table-calc ordering-type="Rows"/></calculation></column><column caption="Month Position To Plot" datatype="date" name="[WW32_Month_Position_To_Plot]" role="dimension" type="quantitative"><calculation class="tableau" formula="DATE(IF [WW32_Month] = 12 THEN DATETRUNC('month', [Order Date]) ELSE IF DAY([Order Date]) &lt;= 15 THEN DATETRUNC('month', [Order Date]) ELSE DATEADD('month', 1, DATETRUNC('month', [Order Date])) - 1 END END)"/></column><column caption="Sales In Month" datatype="real" name="[WW32_Sales_In_Month]" role="measure" type="quantitative"><calculation class="tableau" formula="{FIXED [Category], DATETRUNC('month', [Order Date]): SUM([Sales])}"/></column><column caption="Sales Next Value" datatype="real" name="[WW32_Sales_Next_Value]" role="measure" type="quantitative"><calculation class="tableau" formula="LOOKUP(SUM([WW32_Sales_In_Month]), 1)"><table-calc ordering-type="Rows"/></calculation></column><column caption="Sales Next Value Dual Axis" datatype="real" name="[WW32_Sales_Next_Value_Dual_Axis]" role="measure" type="quantitative"><calculation class="tableau" formula="IF [WW32_Sales_Diff] &lt;&gt; 0 THEN [WW32_Sales_Next_Value] END"><table-calc ordering-type="Rows"/></calculation></column><column caption="Sales in Month Dual Axis" datatype="real" name="[WW32_Sales_in_Month_Dual_Axis]" role="measure" type="quantitative"><calculation class="tableau" formula="IF [WW32_Sales_Diff] &lt;&gt; 0 THEN SUM([WW32_Sales_In_Month]) END"><table-calc ordering-type="Rows"/></calculation></column><column caption="Size - Dual Axis" datatype="integer" name="[WW32_Size_Dual_Axis]" role="measure" type="quantitative"><calculation class="tableau" formula="IF [WW32_Colour_Diff] = 'blue' OR [WW32_Colour_Diff] = 'red' THEN 2 ELSE 1 END"><table-calc ordering-type="Rows"/></calculation></column><column datatype="integer" name="[WW32_Month]" role="measure" type="quantitative"/><column datatype="date" name="[Order Date]" role="dimension" type="ordinal"/><column datatype="real" name="[Sales]" role="measure" type="quantitative"/><column datatype="real" name="[WW32_LABEL_Max_Diff]" role="measure" type="quantitative"/><column datatype="real" name="[WW32_LABEL_Min_Diff]" role="measure" type="quantitative"/><column datatype="boolean" name="[WW32_Is_Min_Value]" role="measure" type="nominal"/><column datatype="boolean" name="[WW32_Is_Max_Value]" role="measure" type="nominal"/><column datatype="real" name="[WW32_Sales_Diff]" role="measure" type="quantitative"/><column-instance column="[Category]" derivation="Attribute" name="[attr:Category:nk]" pivot="key" type="nominal"/><column-instance column="[WW32_LABEL_Month_Position_To_Display]" derivation="Attribute" name="[attr:WW32_LABEL_Month_Position_To_Display:nk]" pivot="key" type="nominal"/><column-instance column="[WW32_LABEL_Month_Position_To_Display]" derivation="Month" name="[mn:WW32_LABEL_Month_Position_To_Display:ok]" pivot="key" type="ordinal"/><column-instance column="[Category]" derivation="None" name="[none:Category:nk]" pivot="key" type="nominal"/><column-instance column="[WW32_Sales_In_Month]" derivation="Sum" name="[sum:WW32_Sales_In_Month:qk]" pivot="key" type="quantitative"/><column-instance column="[WW32_Month_Position_To_Plot]" derivation="Day-Trunc" name="[tdy:WW32_Month_Position_To_Plot:qk]" pivot="key" type="quantitative"/><column-instance column="[WW32_Colour_Diff]" derivation="User" name="[usr:WW32_Colour_Diff:nk]" pivot="key" type="nominal"><table-calc ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Is_Max_Value]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Next_Value]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Diff]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Is_Min_Value]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Max_Diff]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Min_Diff]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/></column-instance><column-instance column="[WW32_LABEL_First_Last_if_not_max_or_min]" derivation="User" name="[usr:WW32_LABEL_First_Last_if_not_max_or_min:qk]" pivot="key" type="quantitative"><table-calc ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Max_Diff]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Is_Min_Value]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Next_Value]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Diff]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Min_Diff]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Is_Max_Value]" ordering-type="Rows"/></column-instance><column-instance column="[WW32_LABEL_Max_Diff_Shift]" derivation="User" name="[usr:WW32_LABEL_Max_Diff_Shift:qk]" pivot="key" type="quantitative"><table-calc ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_LABEL_Max_Diff]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Diff]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Sales_Next_Value]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Is_Max_Value]" ordering-type="Rows"/><table-calc field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[WW32_Max_Diff]" ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot:qk]" ordering-type="Field"/></column-instance><column-instance column="[WW32_LABEL_Min_Diff_Shift]" derivation="User" name="[usr:WW32_LABEL_Min_Diff_Shift:qk]" pivot="key" type="quantitative"><table-calc ordering-field="[federated.0ahyg8e1xelf3914bag3r0yukuro].[tdy:WW32_Month_Position_To_Plot: