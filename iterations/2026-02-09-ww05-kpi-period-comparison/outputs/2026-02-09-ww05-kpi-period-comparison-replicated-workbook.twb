quantitative"><calculation class="tableau" formula="IF MIN([Calculation_B7BC28B0C07645CAA863CC3597841ACF]) &lt;&gt; 'Recent' THEN [Calculation_721030AA625343F3880EDCBB271D1AA4] END"/></column><column caption="X-Axis" datatype="integer" name="[Calculation_626DB46CCF6244C2B6AD05DF6FC2556E]" role="dimension" type="quantitative"><calculation class="tableau" formula="CASE [Calculation_B7BC28B0C07645CAA863CC3597841ACF] WHEN 'Recent' THEN DATEDIFF('day',[Parameters].[Parameter 1],[Order Date]) WHEN 'Prior Month' THEN DATEDIFF('day',[Calculation_FA589655FE6F4CC89BFFE96311CD47B4],[Order Date]) WHEN 'Prior Year' THEN DATEDIFF('day',[Calculation_FC8898BA211E4119BF7674AA13E4843B],[Order Date]) END"/></column><column caption="PR - Today" datatype="real" name="[Calculation_BAD00103ABCC4E2AB4147A74C7CBBF07]" role="measure" type="quantitative" default-format="p0.0%"><calculation class="tableau" formula="{FIXED:SUM(IF [Order Date]=[Parameters].[Parameter 1] THEN [Profit] END)}/{FIXED:SUM(IF [Order Date]=[Parameters].[Parameter 1] THEN [Sales] END)}"/></column><column caption="PR - Yesterday" datatype="real" name="[Calculation_53A8313383414BB6827D060C04E584AC]" role="measure" type="quantitative"><calculation class="tableau" formula="{FIXED:SUM(IF [Order Date]=DATEADD('day', -1,[Parameters].[Parameter 1]) THEN [Profit] END)}/{FIXED:SUM(IF [Order Date]=DATEADD('day', -1,[Parameters].[Parameter 1]) THEN [Sales] END)}"/></column><column caption="PR Difference" datatype="real" name="[Calculation_322E734B13764918923499AB287BED04]" role="measure" type="quantitative" default-format="p0.0%"><calculation class="tableau" formula="[Calculation_BAD00103ABCC4E2AB4147A74C7CBBF07] - [Calculation_53A8313383414BB6827D060C04E584AC]"/></column><column caption="PR Direction Up" datatype="string" name="[Calculation_A127E8B0470C44A28BAC05D7CD7D4C94]" role="dimension" type="nominal"><calculation class="tableau" formula="IF [Calculation_322E734B13764918923499AB287BED04]&gt;=0 THEN 'Up' END"/></column><column