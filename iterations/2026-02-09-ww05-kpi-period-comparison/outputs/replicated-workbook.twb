      <aliases enabled="yes"/>
      <column caption="Today Last Month" datatype="date" name="[Calculation_2476698355235426304]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATE(DATEADD('month', -1, [Parameters].[Parameter 1]))"/>
      </column>
      <column caption="Today Last Year" datatype="date" name="[Calculation_2476698355235586049]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATE(DATEADD('year', -1, [Parameters].[Parameter 1]))"/>
      </column>
      <column caption="Recent | Prior  Mth | Prior Yr" datatype="string" name="[Calculation_2476698355235758082]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Order Date] &gt;= DATEADD('day', -14, [Parameters].[Parameter 1]) AND [Order Date] &lt;= [Parameters].[Parameter 1] THEN 'Recent'&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD('day', -14, [Calculation_2476698355235426304]) AND [Order Date] &lt;= DATEADD('day', 14, [Calculation_2476698355235426304]) THEN 'Prior Month'&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD('day', -14, [Calculation_2476698355235586049]) AND [Order Date] &lt;= DATEADD('day', 14, [Calculation_2476698355235586049]) THEN 'Prior Year'&#13;&#10;ELSE NULL&#13;&#10;END"/>
      </column>
      <column caption="Profit Ratio" datatype="real" default-format="p0.0%" name="[Calculation_2476698355237347332]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Profit]) / SUM([Sales])"/>
      </column>
      <column caption="PR - Recent" datatype="real" default-format="p0.0%" name="[Calculation_2476698355238961157]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF MIN([Calculation_2476698355235758082]) = 'Recent' THEN [Calculation_2476698355237347332] END"/>
      </column>
      <column caption="PR - Today" datatype="real" default-format="p0.0%" name="[Calculation_2476698355241844743]" role="measure" type="quantitative">
        <calculation class="tableau" formula="//IF MIN([Recent | Prior  Mth | Prior Yr]) = 'Recent' AND MIN([X-Axis])=0 THEN [Profit Ratio] END&#13;&#10;{FIXED:SUM(IF [Order Date]=[Parameters].[Parameter 1] THEN [Profit] END)}/{FIXED:SUM(IF [Order Date]=[Parameters].[Parameter 1] THEN [Sales] END)}"/>
      </column>
      <column caption="PR Difference" datatype="real" default-format="p0.0%" name="[Calculation_2476698355243659273]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Calculation_2476698355241844743] - [PR - Today (copy)_2476698355243327496]"/>
      </column>
      <column caption="PR Direction Up" datatype="string" name="[Calculation_2476698355243843594]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_2476698355243659273]&gt;=0 THEN 'Up' END"/>
      </column>
      <column datatype="string" hidden="true" name="[Category]" role="dimension" type="nominal"/>
      <column datatype="string" hidden="true" name="[City]" role="dimension" semantic-role="[City].[Name]" type="nominal"/>
      <column datatype="string" hidden="true" name="[Country/Region]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal"/>
      <column caption="X-Axis" datatype="integer" name="[Current | Prev Mth | Prev Yr (copy)_2476698355236638723]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Calculation_2476698355235758082]&#13;&#10;WHEN 'Recent' THEN DATEDIFF('day',[Parameters].[Parameter 1],[Order Date])&#13;&#10;WHEN 'Prior Month' THEN DATEDIFF('day',[Calculation_2476698355235426304],[Order Date])&#13;&#10;WHEN 'Prior Year' THEN DATEDIFF('day',[Calculation_2476698355235586049],[Order Date])&#13;&#10;END"/>
      </column>
      <column datatype="string" hidden="true" name="[Customer ID]" role="dimension" type="nominal"/>
      <column datatype="string" hidden="true" name="[Customer Name]" role="dimension" type="nominal"/>
      <column datatype="real" hidden="true" name="[Discount]" role="measure" type="quantitative"/>
      <column datatype="string" hidden="true" name="[Order ID]" role="dimension" type="nominal"/>
      <column caption="PR - Not Recent" datatype="real" default-format="p0.0%" name="[PR - Recent (copy)_2476698355240329222]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF MIN([Calculation_2476698355235758082]) &lt;&gt; 'Recent' THEN [Calculation_2476698355237347332] END"/>
      </column>
      <column caption="PR - Yesterday" datatype="real" default-format="p0.0%" name="[PR - Today (copy)_2476698355243327496]" role="measure" type="quantitative">
        <calculation class="tableau" formula="//IF MIN([Recent | Prior  Mth | Prior Yr]) = 'Recent' AND MIN([X-Axis])=0 THEN [Profit Ratio] END&#13;&#10;{FIXED:SUM(IF [Order Date]=DATEADD('day', -1,[Parameters].[Parameter 1]) THEN [Profit] END)}/{FIXED:SUM(IF [Order Date]=DATEADD('day', -1,[Parameters].[Parameter 1]) THEN [Sales] END)}"/>
      </column>
      <column caption="PR Direction Down" datatype="string" name="[PR Direction Up (copy)_2476698355244212235]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_2476698355243659273]&lt;0 THEN 'Down' END"/>
      </column>
      <column datatype="string" hidden="true" name="[Postal Code]" role="dimension" semantic-role="[ZipCode].[Name]" type="nominal"/>
      <column datatype="string" hidden="true" name="[Product ID]" role="dimension" type="nominal"/>
