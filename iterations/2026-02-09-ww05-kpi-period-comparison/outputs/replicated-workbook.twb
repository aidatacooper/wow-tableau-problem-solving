  <worksheets>
    <worksheet name="Period Trend"><layout-options><caption><formatted-text><run>Profit ratio aligned by relative day for recent, prior month, and prior year</run></formatted-text></caption></layout-options><table><view><datasources><datasource caption="Orders (Sample - Superstore)" name="federated.03dtb940se97xw1ersnll1g7udib"/></datasources><datasource-dependencies datasource="federated.03dtb940se97xw1ersnll1g7udib"><column caption="Recent | Prior  Mth | Prior Yr" datatype="string" name="[Calculation_2476698355235758082]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Order Date] &gt;= DATEADD('day', -14, [Parameters].[Parameter 1]) AND [Order Date] &lt;= [Parameters].[Parameter 1] THEN 'Recent'&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD('day', -14, [Calculation_2476698355235426304]) AND [Order Date] &lt;= DATEADD('day', 14, [Calculation_2476698355235426304]) THEN 'Prior Month'&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD('day', -14, [Calculation_2476698355235586049]) AND [Order Date] &lt;= DATEADD('day', 14, [Calculation_2476698355235586049]) THEN 'Prior Year'&#13;&#10;ELSE NULL&#13;&#10;END"/>
      </column>
      <column caption="PR - Recent" datatype="real" default-format="p0.0%" name="[Calculation_2476698355238961157]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF MIN([Calculation_2476698355235758082]) = 'Recent' THEN [Calculation_2476698355237347332] END"/>
      </column>
      <column caption="X-Axis" datatype="integer" name="[Current | Prev Mth | Prev Yr (copy)_2476698355236638723]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Calculation_2476698355235758082]&#13;&#10;WHEN 'Recent' THEN DATEDIFF('day',[Parameters].[Parameter 1],[Order Date])&#13;&#10;WHEN 'Prior Month' THEN DATEDIFF('day',[Calculation_2476698355235426304],[Order Date])&#13;&#10;WHEN 'Prior Year' THEN DATEDIFF('day',[Calculation_2476698355235586049],[Order Date])&#13;&#10;END"/>
      </column>
      <column caption="PR - Not Recent" datatype="real" default-format="p0.0%" name="[PR - Recent (copy)_2476698355240329222]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF MIN([Calculation_2476698355235758082]) &lt;&gt; 'Recent' THEN [Calculation_2476698355237347332] END"/>
      </column>
      <column datatype="date" name="[Calculation_2476698355235426304]" role="dimension" type="ordinal"/><column datatype="date" name="[Calculation_2476698355235586049]" role="dimension" type="ordinal"/><column datatype="real" name="[Calculation_2476698355237347332]" role="measure" type="quantitative"/><column-instance column="[Calculation_2476698355235758082]" derivation="None" name="[none:Calculation_2476698355235758082:nk]" pivot="key" type="nominal"/><column-instance column="[Current | Prev Mth | Prev Yr (copy)_2476698355236638723]" derivation="None" name="[none:Current | Prev Mth | Prev Yr (copy)_2476698355236638723:ok]" pivot="key" type="ordinal"/><column-instance column="[Calculation_2476698355238961157]" derivation="Sum" name="[sum:Calculation_2476698355238961157:qk]" pivot="key" type="quantitative"/><column-instance column="[PR - Recent (copy)_2476698355240329222]" derivation="Sum" name="[sum:PR - Recent (copy)_2476698355240329222:qk]" pivot="key" type="quantitative"/></datasource-dependencies><filter class="categorical" column="[federated.03dtb940se97xw1ersnll1g7udib].[none:Calculation_2476698355235758082:nk]"><groupfilter function="union" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate"><groupfilter function="member" level="[none:Calculation_2476698355235758082:nk]" member="&quot;Recent&quot;"/><groupfilter function="member" level="[none:Calculation_2476698355235758082:nk]" member="&quot;Prior Month&quot;"/><groupfilter function="member" level="[none:Calculation_2476698355235758082:nk]" member="&quot;Prior Year&quot;"/></groupfilter></filter><aggregation value="true"/></view><style><style-rule element="axis"><encoding attr="space" class="1" field="[federated.03dtb940se97xw1ersnll1g7udib].[sum:PR - Recent (copy)_2476698355240329222:qk]" field-type="quantitative" fold="true" scope="rows" synchronized="true" type="space"/><encoding attr="space" class="0" field="[federated.03dtb940se97xw1ersnll1g7udib].[sum:Calculation_24766