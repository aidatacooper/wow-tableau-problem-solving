  <worksheets>
    <worksheet name="Higher Orders by Month"><layout-options><caption><formatted-text><run>Monthly average orders per day compared with each segment's overall average</run></formatted-text></caption></layout-options><table><view><datasources><datasource caption="Orders (Sample - Superstore)" name="federated.15oc3a818szs5v19de4b906f514y"/></datasources><datasource-dependencies datasource="federated.15oc3a818szs5v19de4b906f514y"><column caption="Difference" datatype="real" default-format="*+0%;-0%" name="[% Difference (copy)]" role="measure" type="quantitative">
        <calculation class="tableau" formula="([Calculation_130322926796525572]-[Calculation_130322926793674755])"/>
      </column>
      <column caption="Overall Avg Orders Per Day Per Segment" datatype="real" default-format="n#,##0.00;-#,##0.00" name="[Calculation_130322926793674755]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_130322926792994817]) / SUM([Calculation_130322926793535490])"/>
      </column>
      <column caption="Avg Orders Per Day Per Segment Per Month" datatype="real" default-format="n#,##0.00;-#,##0.00" name="[Calculation_130322926796525572]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Count Orders per Segment (copy)])/ SUM([Count Dates Per Segment (copy)])"/>
      </column>
      <column caption="% Difference" datatype="real" default-format="*+0%;-0%" name="[Calculation_130322926797197317]" role="measure" type="quantitative">
        <calculation class="tableau" formula="([Calculation_130322926796525572]-[Calculation_130322926793674755])/[Calculation_130322926793674755]"/>
      </column>
      <column caption="COLOUR:Difference" datatype="string" name="[Calculation_130322926801391623]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [% Difference (copy)]&gt;=0 THEN 'green' ELSE 'blue' END"/>
      </column>
