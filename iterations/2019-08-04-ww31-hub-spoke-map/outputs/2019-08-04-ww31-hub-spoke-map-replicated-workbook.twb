      <column datatype="string" name="[Artist]" role="dimension" type="nominal"/>
      <column caption="# Concerts" datatype="integer" name="[Calculation_488922052502458368]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([ConcertID])"/>
      </column>
      <column caption="Route" datatype="spatial" name="[Calculation_488922052509372417]" role="measure" type="nominal">
        <calculation class="tableau" formula="MAKELINE(MAKEPOINT([Hometown Latitude],[Hometown Longitude]), MAKEPOINT([Lat],[Long]))"/>
      </column>
      <column caption="Calculation1" datatype="string" name="[Calculation_754915905886633984]" role="dimension" type="nominal">
        <calculation class="tableau" formula="STR([Concert Date]) + '-' + [Concert]"/>
      </column>
      <column caption="Destination" datatype="spatial" name="[Calculation_754915905889980417]" role="measure" type="nominal">
