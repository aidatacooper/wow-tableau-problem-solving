      </column>
      <column caption="Filter Date" datatype="boolean" hidden="true" name="[Calculation_1462388111888388]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Order Date]&gt;= [Parameters].[Parameter 1] AND [Order Date]&lt;=[Parameters].[Parameter 2]"/>
      </column>
      <column caption="#Orders in Date Range" datatype="integer" name="[Calculation_1462388112908293]" role="measure" type="quantitative">
        <calculation class="tableau" formula="ZN(COUNTD(IF [Order Date]&gt;=[Parameters].[Parameter 1]AND [Order Date]&lt;=[Parameters].[Parameter 2]THEN [Order ID] END))"/>
      </column>
      <column caption="In Date Range" datatype="boolean" hidden="true" name="[Calculation_1462388616515590]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Order Date]&lt;= [Parameters].[Parameter 2] AND [Order Date]&gt;= [Parameters].[Parameter 1]"/>
      </column>
      <column caption="Number Prefix *" datatype="string" name="[Calculation_1462388620169228]" role="measure" type="nominal">
