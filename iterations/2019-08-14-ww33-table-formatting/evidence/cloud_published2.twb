            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.110305'>
            <column caption='Profit Ratio' datatype='real' default-format='p0%' name='[Calculation_ProfitRatio]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
            </column>
            <column caption='Total Sales for Year &amp; Category' datatype='real' name='[Calculation_TotalSalesYearCat]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED YEAR([Order Date]), [Sub-Category]: SUM([Sales])}' />
            </column>
            <column caption='% Sales for Selected Region' datatype='real' default-format='p0%' name='[Calculation_PctSelectedRegion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales])/SUM([Calculation_TotalSalesYearCat])' />
            </column>
            <column caption='Highlight' datatype='boolean' name='[Calculation_Highlight]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_PctSelectedRegion] &gt; ([Parameters].[Parameter 1]/100)' />
