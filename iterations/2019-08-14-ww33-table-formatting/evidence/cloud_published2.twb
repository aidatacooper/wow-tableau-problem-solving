    <worksheet name='Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample _ Superstore (Simple)' name='federated.110305' />
          </datasources>
          <datasource-dependencies datasource='federated.110305'>
            <column caption='Total Sales for Year &amp; Category' datatype='real' name='[Calculation_TotalSalesYearCat]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED YEAR([Order Date]), [Sub-Category]: SUM([Sales])}' />
            </column>
            <column caption='% Sales for Selected Region' datatype='real' default-format='p0%' name='[Calculation_PctSelectedRegion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales])/SUM([Calculation_TotalSalesYearCat])' />
            </column>
            <column caption='% Sales All Others' datatype='real' default-format='p0%' name='[Calculation_PctAllOthers]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Calculation_PctSelectedRegion]' />
            </column>
            <column caption='MIN(1) Bar' datatype='integer' name='[Calculation_BarMin1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='LABEL:Bar' datatype='string' name='[Calculation_LabelBar]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Region] + &apos; vs. All Other Regions&apos;' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_LabelBar]' derivation='None' name='[none:Calculation_LabelBar:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sub-Category]' derivation='None' name='[none:Sub-Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Date]' derivation='Year' name='[yr:Order Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_PctSelectedRegion]' derivation='User' name='[usr:Calculation_PctSelectedRegion:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_PctAllOthers]' derivation='User' name='[usr:Calculation_PctAllOthers:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_BarMin1]' derivation='User' name='[usr:Calculation_BarMin1:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.110305].[none:Region:nk]</column>
            <column>[federated.110305].[none:Sub-Category:nk]</column>
            <column>[federated.110305].[yr:Order Date:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
