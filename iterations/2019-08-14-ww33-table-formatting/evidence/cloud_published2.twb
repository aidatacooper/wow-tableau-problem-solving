      <aliases enabled='yes' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
      <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column datatype='date' name='[Ship Date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
      <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='integer' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column datatype='string' name='[Product ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
      <column caption='Profit Ratio' datatype='real' default-format='p0%' name='[Calculation_ProfitRatio]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Total Sales for Year &amp; Category' datatype='real' name='[Calculation_TotalSalesYearCat]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED YEAR([Order Date]), [Sub-Category]: SUM([Sales])}' />
      </column>
      <column caption='% Sales for Selected Region' datatype='real' default-format='p0%' name='[Calculation_PctSelectedRegion]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/SUM([Calculation_TotalSalesYearCat])' />
      </column>
      <column caption='% Sales All Others' datatype='real' default-format='p0%' name='[Calculation_PctAllOthers]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_PctSelectedRegion]' />
      </column>
      <column caption='Highlight' datatype='boolean' name='[Calculation_Highlight]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_PctSelectedRegion] &gt; ([Parameters].[Parameter 1]/100)' />
      </column>
      <column caption='LABEL:Subcat BOLD' datatype='string' name='[Calculation_LabelSubcatBold]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_Highlight] THEN ATTR([Sub-Category]) END' />
      </column>
      <column caption='LABEL:Subcat Normal' datatype='string' name='[Calculation_LabelSubcatNormal]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF NOT([Calculation_Highlight]) THEN ATTR([Sub-Category]) END' />
      </column>
      <column caption='LABEL:Sales BOLD' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_LabelSalesBold]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_Highlight] THEN SUM([Sales]) END' />
      </column>
      <column caption='LABEL:Sales Normal' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_LabelSalesNormal]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF NOT([Calculation_Highlight]) THEN SUM([Sales]) END' />
      </column>
      <column caption='LABEL:Profit BOLD' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_LabelProfitBold]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_Highlight] THEN SUM([Profit]) END' />
      </column>
      <column caption='LABEL:Profit Normal' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_LabelProfitNormal]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF NOT([Calculation_Highlight]) THEN SUM([Profit]) END' />
      </column>
      <column caption='LABEL:Profit Ratio BOLD' datatype='real' default-format='p0%' name='[Calculation_LabelRatioBold]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_Highlight] THEN [Calculation_ProfitRatio] END' />
      </column>
      <column caption='LABEL:Profit Ratio Normal' datatype='real' default-format='p0%' name='[Calculation_LabelRatioNormal]' role='measure' type='ordinal'>
