{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/donnacoles/case.schema.json",
  "title": "Donna Coles Tableau Case",
  "type": "object",
  "required": ["schema_version", "case_id", "article", "tableau_links", "resources", "collection"],
  "properties": {
    "schema_version": {"type": "string"},
    "case_id": {"type": "string", "pattern": "^donna-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"},
    "article": {
      "type": "object",
      "required": ["title", "published_date", "canonical_url", "asset"],
      "properties": {
        "title": {"type": "string"},
        "published_date": {"type": "string", "format": "date"},
        "canonical_url": {"type": "string", "format": "uri"},
        "asset": {"type": "object"},
        "embedded_images": {"type": "array", "items": {"type": "object"}}
      }
    },
    "tableau_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "raw_url",
          "workbook_name",
          "view",
          "role",
          "role_confidence",
          "requires_manual_role_review"
        ]
      }
    },
    "resources": {"type": "array", "items": {"type": "object"}},
    "collection": {"type": "object"}
  },
  "additionalProperties": false
}
