{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iteration identity summary (not source dataset article schema)",
  "type": "object",
  "required": [
    "case_id",
    "iteration_id",
    "legacy_case_ids",
    "article_date",
    "challenge_year",
    "challenge_week",
    "source_workbook_date",
    "source",
    "verification_status",
    "artifacts"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^wow-[0-9]{4}-ww[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "iteration_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-ww[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "legacy_case_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "article_date": {
      "type": "string",
      "format": "date"
    },
    "challenge_year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "challenge_week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 53
    },
    "source_workbook_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source": {
      "type": "object"
    },
    "verification_status": {
      "enum": [
        "pending",
        "historical",
        "verified"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "primary_workbook"
      ],
      "properties": {
        "primary_workbook": {
          "const": "outputs/replicated-workbook.twbx"
        },
        "cloud_author": {
          "enum": [
            null,
            "outputs/cloud-author.png"
          ]
        },
        "cloud_replica": {
          "enum": [
            null,
            "outputs/cloud-replica.png"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
