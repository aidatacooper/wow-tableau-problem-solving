{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/donnacoles/usage.schema.json",
  "title": "Case usage registry, including immutable v1 history",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "updated_at",
        "selection_policy",
        "consumed_cases"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        },
        "selection_policy": {
          "const": "exclude_consumed_cases_from_future_feature_iterations"
        },
        "consumed_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "workbook_ids",
              "iteration",
              "status",
              "replication_status",
              "cwtwb_version",
              "cwtwb_commits",
              "capabilities",
              "reason"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^donna-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"
              },
              "workbook_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^tableau-[a-f0-9]{16}$"
                }
              },
              "iteration": {
                "type": "string"
              },
              "status": {
                "const": "consumed"
              },
              "replication_status": {
                "enum": [
                  "partial",
                  "replicated",
                  "blocked"
                ]
              },
              "cwtwb_version": {
                "type": "string"
              },
              "cwtwb_commits": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "generated_from",
        "selection_policy",
        "legacy_case_ids",
        "consumed_cases"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "generated_from": {
          "const": "usage/case-index.json"
        },
        "selection_policy": {
          "const": "exclude_consumed_cases_from_future_feature_iterations"
        },
        "legacy_case_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^wow-[0-9]{4}-ww(?:0[1-9]|[1-4][0-9]|5[0-3])-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "consumed_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "legacy_case_ids",
              "workbook_ids",
              "iteration",
              "status",
              "replication_status",
              "verification_status",
              "cwtwb_version",
              "reason"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^wow-[0-9]{4}-ww(?:0[1-9]|[1-4][0-9]|5[0-3])-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "legacy_case_ids": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^wow-[0-9]{4}-ww(?:0[1-9]|[1-4][0-9]|5[0-3])-[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "workbook_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^tableau-[a-f0-9]{16}$"
                }
              },
              "iteration": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-ww[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "status": {
                "const": "consumed"
              },
              "replication_status": {
                "enum": [
                  "pending",
                  "partial",
                  "replicated",
                  "blocked"
                ]
              },
              "verification_status": {
                "enum": [
                  "pending",
                  "historical",
                  "verified"
                ]
              },
              "cwtwb_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
